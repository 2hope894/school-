<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="10dp"
    android:foreground="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    card_view:cardCornerRadius="16dp"
    card_view:cardElevation="8dp"
    card_view:cardUseCompatPadding="true">

    <LinearLayout
        android:orientation="vertical"
        android:padding="18dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/white">

        <!-- Company Name -->
        <TextView
            android:id="@+id/txtCompanyName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="TechLens Solutions"
            android:textStyle="bold"
            android:textColor="#1E88E5"
            android:textSize="30sp"
            android:layout_marginBottom="4dp" />

        <!-- Job Title -->
        <TextView
            android:id="@+id/txtJobTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Software Engineer"
            android:textStyle="bold"
            android:textColor="#0D47A1"
            android:textSize="20sp"
            android:layout_marginBottom="6dp" />

        <!-- Job Category & Region -->
        <TextView
            android:id="@+id/txtCategoryRegion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=" Software • Lusaka"
            android:textSize="14sp"
            android:textColor="#212121"
            android:layout_marginBottom="6dp" />

        <!-- Short Job Description -->
        <TextView
            android:id="@+id/txtShortDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="We are looking for a passionate Android developer to join our growing team..."
            android:textSize="14sp"
            android:textColor="#212121"
            android:maxLines="3"
            android:ellipsize="end"
            android:layout_marginBottom="10dp" />

        <!-- Job Info Section -->
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp">

            <TextView
                android:id="@+id/txtLocation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📍 Location: Lusaka"
                android:textSize="13sp"
                android:textColor="#212121"
                android:layout_marginBottom="2dp" />

            <TextView
                android:id="@+id/txtSalary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="💰 Salary: K8,000 - K12,000/month"
                android:textSize="13sp"
                android:textColor="#212121"
                android:layout_marginBottom="2dp" />

            <TextView
                android:id="@+id/txtPostedDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🕓 Posted: 12 Oct 2025"
                android:textSize="13sp"
                android:textColor="#212121" />
        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E0E0E0"
            android:layout_marginBottom="6dp" />

        <!-- Footer text -->
        <TextView
            android:id="@+id/txtApplyInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" Tap to view details and apply"
            android:textSize="12sp"
            android:textColor="#1976D2"
            android:textStyle="italic"
            android:layout_gravity="end" />

    </LinearLayout>
</androidx.cardview.widget.CardView>
